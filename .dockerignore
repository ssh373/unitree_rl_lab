# ignore .git related folders
.git/
.github/
.gitignore
# ignore docs
docs/
# ignore logs
**/logs/
**/runs/
**/output/*
**/outputs/*
**/videos/*
*.tmp
# ignore docker
docker/cluster/exports/
docker/.container.cfg
# ignore recordings
recordings/
# ignore __pycache__
**/__pycache__/
**/*.egg-info/
# ignore isaac sim symlink
_isaac_sim?
# ignore robot description files placed inside the repo (mount them instead, see docker/README.md)
unitree_model/
unitree_ros/
# ignore compiled deploy controllers
deploy/**/build/
# ignore user-specific compose settings
docker/.env
# ignore local wandb run cache (GBs; never needed in the image)
wandb/
