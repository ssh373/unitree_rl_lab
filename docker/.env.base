###
# Build / run settings for docker/docker-compose.yaml
#
# Compose does NOT read this file automatically. Either copy it to `docker/.env`
# (auto-loaded by `docker compose -f docker/docker-compose.yaml ...`) or pass
# `--env-file docker/.env.base`. Every value here has the same default inside
# docker-compose.yaml, so this file is only needed to override something.
###

# Isaac Lab base image (public NGC image, linux/amd64 + linux/arm64).
# Alternatives: nvcr.io/nvidia/isaac-lab:2.3.0, nvcr.io/nvidia/isaac-lab:2.3.1,
# or a locally built `isaac-lab-base` (IsaacLab/docker/container.py start).
ISAACLAB_BASE_IMAGE=nvcr.io/nvidia/isaac-lab:2.3.2

# name:tag of the image produced by `docker compose build`.
UNITREE_RL_LAB_IMAGE=unitree-rl-lab:2.3.2

# Path of this repository inside the container.
DOCKER_UNITREE_RL_LAB_PATH=/workspace/unitree_rl_lab

# Host directories holding the Unitree robot description files. They are bind-mounted
# to /workspace/unitree_model and /workspace/unitree_ros inside the container.
#   git clone https://huggingface.co/datasets/unitreerobotics/unitree_model
#   git clone https://github.com/unitreerobotics/unitree_ros.git
UNITREE_MODEL_HOST_DIR=${HOME}/unitree_model
UNITREE_ROS_HOST_DIR=${HOME}/unitree_ros

# name:tag of the self-contained image (docker/Dockerfile target `full`).
UNITREE_RL_LAB_SELFCONTAINED_IMAGE=unitree-rl-lab:2.3.2-selfcontained

# Where the self-contained image gets the robot description files:
#   clone - download them during the build (needs network access)
#   local - copy them from the named build contexts `unitree_model` / `unitree_ros`
#           (docker build --build-context unitree_model=/path/to/unitree_model ...)
ASSETS_SOURCE=clone
